# EXAMPLE ONLY. Run scripts/postgres_deploy.py init to generate private files.
PL_PG_IMAGE=postgres:16-bookworm
PL_PG_BIND=127.0.0.1
PL_PG_PORT=55432
PL_PG_SECRET_DIR=/absolute/path/to/project/deploy/postgres/private/secrets
# Server TLS overlay also requires:
# PL_PG_TLS_CERT=/absolute/path/to/server.crt
# PL_PG_TLS_KEY=/absolute/path/to/server.key
