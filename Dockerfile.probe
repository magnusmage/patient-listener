# Disposable, synthetic-only G-02 test. No application, database or models.
FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir "fastapi~=0.142" "uvicorn[standard]~=0.54"
RUN groupadd --gid 10001 probe && useradd --uid 10001 --gid 10001 --create-home probe
WORKDIR /probe
COPY deploy/websocket_probe.py ./websocket_probe.py
USER 10001:10001
EXPOSE 8000
CMD ["python", "websocket_probe.py"]
