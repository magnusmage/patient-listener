# Patient Listener — environment. The ONLY place config is read (src/patient_listener/config.py).
# Copy to .env (git-ignored). Loaded from the working directory at startup.
# Exported variables win; PL_ENV_FILE selects another explicit file. Restart after edits.

# --- Token Factory (model calls only) ---
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=                                   # server only, NEVER in the browser
REPLY_MODEL=nvidia/Nemotron-3_5-Lightning          # confirm with GET /v1/models (DR-0)
PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b
ASR_MODEL=nvidia/nemotron-speech-streaming-en-0.6b
TTS_MODEL=nvidia/magpie_tts_multilingual_357m
TTS_VOICE=Aria
ASR_CHUNK_MS=160

# --- Waits (starting values; an SLT tunes per person within the PauseConfig ranges) ---
WAIT_BACKCHANNEL_S=4
WAIT_OFFER_HINT_S=7
WAIT_MAX_S=20
LIVE_REPLY_TIMEOUT_S=1.5
COMPLETE_CHECK_TIMEOUT_S=1.0
MAX_LIGHTNING_CALLS=60

# --- Kill switch (FR-84): false = templates only, no redeploy ---
AI_ENABLED=true

# --- Data (choose SQLite locally OR PostgreSQL on deployment) ---
DATABASE_URL=sqlite:///./pl.db
# DATABASE_URL=postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@HOST:5432/DB?sslmode=verify-full
# For a private CA append &sslrootcert=/absolute/path/to/ca.pem.
# Unset PL_DB_PATH when using PostgreSQL. Run migrations before starting the app.

# --- App API server (frontend <-> core) ---
SESSION_TOKEN_SECRET=                              # HMAC secret for session tokens; blank = random per process
SESSION_TOKEN_TTL_S=900                            # session token lifetime (15 minutes)
PL_ENV=development                                 # production requires SESSION_TOKEN_SECRET and HTTPS/WSS
REQUIRE_HTTPS=false                                # automatically true when PL_ENV=production
TRUST_PROXY_HEADERS=false                          # true only behind a proxy that removes client-supplied forwarded headers
CONSOLE_DEMO_ENABLED=false                        # judge console uses a separate in-memory demo store
# PL_DB_PATH=pl.db                                # app SQLite file; needed for console provisioning

# --- Carer agent sandbox (injected into OpenShell only) ---
TELEGRAM_BOT_TOKEN=
PIPECAT_WEBSOCKET_AUTH=token
OPENSHELL_MIN_VERSION=0.0.34                        # CVE-2026-65093 / 65083
TELEGRAM_GROUP_POLICY=disabled                      # NemoClaw #12409

# --- Tracing / scheduling / audio ---
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
FSRS_DESIRED_RETENTION=0.85
FSRS_MAXIMUM_INTERVAL=60
BOOST_ALPHA=2.0
CLIP_LUFS=-20.0

# Load the local GPU voice models and enable the browser voice path.
VOICE_ENABLED=false


# --- Development nightly scheduler (also read from .env) ---
NIGHTLY_ENABLED=false
NIGHTLY_ACTOR_ID=sam                  # existing provisioned helper ID; links/role rechecked
NIGHTLY_PEOPLE=margaret               # comma-separated aliases or person IDs
NIGHTLY_TIME=02:00                    # 24-hour local time in NIGHTLY_TIMEZONE
NIGHTLY_TIMEZONE=Asia/Karachi          # choose the intended IANA timezone
NIGHTLY_MAX_WORDS=1                   # per person, 1..10
NIGHTLY_USE_AI=false                  # explicit opt-in; saved AI switch must also allow calls
NIGHTLY_MAX_MODEL_CALLS=1              # total reserved Super attempts per local date, all people
NIGHTLY_RENDER_AUDIO=true             # reuse loaded GPU models; false permits text-only runs
